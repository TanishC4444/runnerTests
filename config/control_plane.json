{
  "github": {
    "default_owner": "TanishC4444",
    "default_repository": "runnerTests",
    "allowed_owners": ["TanishC4444"],
    "allowed_repositories": ["*"],
    "allow_create_repository": true,
    "allow_workflow_file_edits": false,
    "max_file_bytes": 262144
  },
  "models": {
    "tool_router": "gpt-oss:20b",
    "tool_router_workflow": "gptoss_watcher.yml",
    "background_worker": "gpt-oss:20b",
    "background_workflow": "agent_worker.yml"
  },
  "safeguards": {
    "require_approval_for_writes": false,
    "deny_destructive_tools": true,
    "approval_ttl_seconds": 900
  },
  "skills_directory": "skills",
  "mcp_servers": {
    "github": {
      "enabled": true,
      "transport": "streamable_http",
      "url": "https://api.githubcopilot.com/mcp/x/repos,issues,pull_requests,actions,code_security,discussions,gists,notifications,orgs,projects,users,security_advisories,labels,dependabot,stargazers",
      "read_only": false,
      "auth": "github_oauth",
      "toolsets": ["repos", "issues", "pull_requests", "actions", "code_security", "discussions", "gists", "notifications", "orgs", "projects", "users", "security_advisories", "labels", "dependabot", "stargazers"]
    }
  }
}