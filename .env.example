# Primary hosted model router / voice responder
GROQ_API_KEY=

# Existing GitHub workflow fallback and direct GitHub API access.
# You can leave this blank if you connect GitHub OAuth from the dashboard,
# but the voice fallback workflow still needs GH_TOKEN at process startup.
GH_TOKEN=

# Optional GitHub OAuth App with Device Flow enabled.
# The value is not a secret; enter it in the dashboard when connecting.
GITHUB_OAUTH_CLIENT_ID=

# Optional overrides
GROQ_MODEL=qwen/qwen3.6-27b
GITHUB_REPOSITORY=TanishC4444/runnerTests
