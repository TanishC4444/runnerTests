# Required for everything: triggers/waits on gptoss_watcher.yml, relays chat
# completions to it via ollama_relay.py (GitHub Contents API), and does
# direct GitHub API access. Also needs repo + workflow scope.
GH_TOKEN=

# Optional GitHub OAuth App with Device Flow enabled.
# The value is not a secret; enter it in the dashboard when connecting.
GITHUB_OAUTH_CLIENT_ID=

# Optional overrides
LOCAL_RESPONDER_MODEL=gpt-oss:20b
GITHUB_REPOSITORY=TanishC4444/runnerTests
